# Maintainer: marktantongco <https://github.com/marktantongco>
#
# Arch Linux / omArchy package for the OWL-AGENT proxy defense stack.
#
# Build from a checkout:
#     bash packaging/make-source.sh      # writes owl-agent-proxy-7.1.0.tar.gz here
#     cd packaging && makepkg -si
#
# The tarball is a plain `git archive` of a committed tree, so the package is
# built from an exact commit rather than whatever `main` happens to be. That is
# the point of packaging it: pacman owns install, upgrade and removal, and the
# dependency list is declared instead of drifting with a shell script.

pkgname=owl-agent-proxy
pkgver=7.1.0
pkgrel=1
pkgdesc="Layered HTTP defense stack: caching, dedupe, rate limiting, sticky proxy rotation, honeypot detection and a stdio MCP server"
arch=('any')
url="https://github.com/marktantongco/owl-agent-proxy"
license=('MIT')
# Only what the modules actually import. The requirements.txt list is broader
# (cachetools, orjson, cryptography, tenacity, ... none of which these three
# modules import), and pulling those in is what forced a from-source Rust build
# on Arch. Verified by grepping imports in proxy_defense/proxy_harvester/
# mcp_proxy_server.
depends=(
    'python'
    'python-aiohttp'
    'python-aiofiles'
    'python-httpx'
)
# The escalation ladder is optional by design: http/1.1 must work without any of
# these. Note optdepends entries take 'name: description' — an [extra] suffix is
# rejected by makepkg as an invalid character.
optdepends=(
    'python-h2: http/2 escalation'
    'python-curl-cffi: JA3/TLS fingerprint escalation'
    'python-websockets: WebSocket escalation'
    'python-playwright: browser escalation (then: playwright install chromium)'
    'python-redis: shared cache and rate-limit state'
)
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
# The tarball is produced locally by make-source.sh, so its hash changes with
# every commit. Referencing a tag/release here would make this reproducible;
# until one is cut, SKIP is the honest value.
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"

    # `python -m installer` resolves paths through the interpreter it runs under.
    # Inside a venv that yields $pkgdir/<venv>/lib/... instead of
    # $pkgdir/usr/lib/..., producing a package that installs to the wrong place.
    # makepkg is normally run in a clean shell, but say so plainly if it is not.
    if ! python -c 'import sys; raise SystemExit(0 if sys.prefix == sys.base_prefix else 1)'; then
        error "makepkg is running inside a virtualenv ($(python -c 'import sys; print(sys.prefix)'))."
        error "Deactivate it (or unset VIRTUAL_ENV) and build with the system python."
        return 1
    fi

    python -m build --wheel --no-isolation
}

package() {
    cd "$pkgname-$pkgver"

    python -m installer --destdir="$pkgdir" dist/*.whl

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

    local doc
    for doc in docs/*.md; do
        install -Dm644 "$doc" "$pkgdir/usr/share/doc/$pkgname/docs/$(basename "$doc")"
    done

    install -Dm644 config/proxy_pool.template.json \
        "$pkgdir/usr/share/$pkgname/proxy_pool.template.json"

    # The MCP server is stdlib-only and resolves the backend lazily, so the
    # entry point works before any proxy is configured.
    install -d "$pkgdir/var/lib/$pkgname"
}
