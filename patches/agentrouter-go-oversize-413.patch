@@ -0,0 +1,61 @@
+package e2e
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"net"
+	"net/http"
+	"testing"
+	"time"
+)
+
+// A client may wait for the response without sending an oversized body,
+// with or without Expect. The server must not wait for that upload forever.
+func TestOWLHeaderOnlyOversize(t *testing.T) {
+	for _, expect := range []bool{false, true} {
+		t.Run(fmt.Sprintf("expect=%v", expect), func(t *testing.T) {
+			env := newEnv(t, nil)
+			c, err := net.Dial("tcp", env.Addr)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer c.Close()
+			_ = c.SetDeadline(time.Now().Add(4 * time.Second))
+			h := ""
+			if expect {
+				h = "Expect: 100-continue\r\n"
+			}
+			_, err = fmt.Fprintf(c, "POST /v1/messages HTTP/1.1\r\nHost: %s\r\nContent-Length: 22020096\r\n%s\r\n", env.Addr, h)
+			if err != nil {
+				t.Fatal(err)
+			}
+			started := time.Now()
+			resp, err := http.ReadResponse(bufio.NewReader(c), nil)
+			if err != nil {
+				t.Fatalf("response: %v", err)
+			}
+			defer resp.Body.Close()
+			if resp.StatusCode != http.StatusRequestEntityTooLarge {
+				t.Fatalf("status=%d", resp.StatusCode)
+			}
+			if time.Since(started) > time.Second {
+				t.Fatal("rejection was delayed waiting for the body")
+			}
+			var body struct {
+				Error struct {
+					Code string `json:"code"`
+				} `json:"error"`
+			}
+			if err := json.NewDecoder(resp.Body).Decode(&body); err != nil {
+				t.Fatal(err)
+			}
+			if body.Error.Code != "payload_too_large" {
+				t.Fatalf("code=%q", body.Error.Code)
+			}
+			if env.Mock.PostCount() != 0 {
+				t.Fatal("unexpected upstream POST")
+			}
+		})
+	}
+}
