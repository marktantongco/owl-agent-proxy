+package e2e
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"net"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/trefeon/agentrouter-spoof-proxy/internal/config"
+	"github.com/trefeon/agentrouter-spoof-proxy/internal/proxy"
+)
+
+func TestOWLLocalRejectStalledBodies(t *testing.T) {
+	cases := []struct {
+		name, method, path string
+		length             int
+		auth               bool
+		expect             int
+		code               string
+	}{
+		{"unknown", "POST", "/missing", 32, false, 404, "not_found"},
+		{"unknown-expect", "POST", "/missing", 32, false, 404, "not_found"},
+		{"unauthorized", "POST", "/v1/messages", 32, false, 401, "unauthorized"},
+		{"method", "PUT", "/v1/messages", 32, true, 405, "method_not_allowed"},
+		{"count-unauthorized", "POST", "/v1/messages/count_tokens", 32, false, 401, "unauthorized"},
+		{"count-too-large", "POST", "/v1/messages/count_tokens", proxy.MaxBodySize + 1, true, 413, "payload_too_large"},
+		{"count-timeout", "POST", "/v1/messages/count_tokens", 32, true, 408, "request_timeout"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			env := newEnv(t, func(c *config.Config) { c.ProxyAuthToken = "test-token"; c.BodyUploadTimeoutMs = 500 })
+			c, err := net.Dial("tcp", env.Addr)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer c.Close()
+			_ = c.SetDeadline(time.Now().Add(2 * time.Second))
+			auth := ""
+			if tc.auth {
+				auth = "X-Proxy-Token: test-token\r\n"
+			}
+			if strings.HasSuffix(tc.name, "-expect") {
+				auth += "Expect: 100-continue\r\n"
+			}
+			_, err = fmt.Fprintf(c, "%s %s HTTP/1.1\r\nHost: %s\r\nContent-Length: %d\r\n%s\r\n", tc.method, tc.path, env.Addr, tc.length, auth)
+			if err != nil {
+				t.Fatal(err)
+			}
+			resp, err := http.ReadResponse(bufio.NewReader(c), nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer resp.Body.Close()
+			if resp.StatusCode != tc.expect {
+				t.Fatalf("status=%d want=%d", resp.StatusCode, tc.expect)
+			}
+			var data struct {
+				Error struct {
+					Code string `json:"code"`
+				} `json:"error"`
+			}
+			if err = json.NewDecoder(resp.Body).Decode(&data); err != nil {
+				t.Fatal(err)
+			}
+			if data.Error.Code != tc.code {
+				t.Fatalf("code=%s want=%s", data.Error.Code, tc.code)
+			}
+			if env.Mock.PostCount() != 0 {
+				t.Fatal("request forwarded upstream")
+			}
+		})
+	}
+}
+
+func TestOWLCountTokensNormal(t *testing.T) {
+	env := newEnv(t, func(c *config.Config) { c.ProxyAuthToken = "test-token"; c.BodyUploadTimeoutMs = 5000 })
+	status, body := postBody(t, env, "/v1/messages/count_tokens", `{"model":"test","messages":[{"role":"user","content":"hello"}]}`, map[string]string{"X-Proxy-Token": "test-token", "Content-Type": "application/json"})
+	if status != 200 {
+		t.Fatalf("status=%d body=%s", status, body)
+	}
+	var data map[string]any
+	if err := json.Unmarshal(body, &data); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := data["input_tokens"]; !ok {
+		t.Fatalf("missing input_tokens: %s", body)
+	}
+	if env.Mock.PostCount() != 0 {
+		t.Fatal("request forwarded upstream")
+	}
+}
