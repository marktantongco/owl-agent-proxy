@@ -5,6 +5,7 @@ package server
 import (
 	"context"
 	"encoding/json"
+	"errors"
 	"fmt"
 	"io"
 	"log/slog"
@@ -341,14 +342,25 @@ func isSpace(b byte) bool {
 	return b == ' ' || b == '\t' || b == '\r' || b == '\n' || b == '\v' || b == '\f'
 }
 
-// rejectLocally sends a local error JSON and drains the request body so
-// the keep-alive socket stays clean. Mirrors proxy.mjs rejectLocally.
+// rejectLocally sends the error before a bounded, deadline-limited drain.
+// An incomplete HTTP/1 body cannot safely be reused for another request.
 func rejectLocally(w http.ResponseWriter, r *http.Request, status int, code, message string) {
+	rc := http.NewResponseController(w)
+	hasBody := r.Body != nil && (r.ContentLength != 0 || len(r.TransferEncoding) != 0)
+	if hasBody && r.ProtoMajor == 1 {
+		w.Header().Set("Connection", "close")
+	}
+	if hasBody {
+		_ = rc.SetReadDeadline(time.Now().Add(2 * time.Second))
+	}
 	respondJSON(w, status, map[string]any{
 		"error": map[string]any{"code": code, "message": message, "type": "proxy_error"},
 	})
-	if r.Body != nil {
-		_, _ = io.Copy(io.Discard, r.Body)
+	if hasBody {
+		_ = rc.Flush()
+		_, _ = io.CopyN(io.Discard, r.Body, 1<<20)
+		_ = r.Body.Close()
+		_ = rc.SetReadDeadline(time.Time{})
 	}
 }
 
@@ -415,14 +427,26 @@ func (s *Server) handleCountTokens(w http.ResponseWriter, r *http.Request) {
 		rejectLocally(w, r, http.StatusUnauthorized, "unauthorized", "Invalid or missing proxy auth token")
 		return
 	}
+	if r.ContentLength > proxy.MaxBodySize {
+		rejectLocally(w, r, http.StatusRequestEntityTooLarge, "payload_too_large", "Request body too large")
+		return
+	}
+	rc := http.NewResponseController(w)
+	_ = rc.SetReadDeadline(time.Now().Add(s.cfg.BodyUploadTimeout()))
 	raw, err := io.ReadAll(io.LimitReader(r.Body, proxy.MaxBodySize+1))
 	if err != nil {
-		rejectLocally(w, r, http.StatusBadRequest, "bad_request", "Failed to read request body")
+		var ne net.Error
+		if errors.As(err, &ne) && ne.Timeout() {
+			rejectLocally(w, r, http.StatusRequestTimeout, "request_timeout", "Request body upload timed out")
+		} else if r.Context().Err() == nil {
+			rejectLocally(w, r, http.StatusBadRequest, "bad_request", "Failed to read request body")
+		}
 		return
 	}
 	if len(raw) > proxy.MaxBodySize {
 		rejectLocally(w, r, http.StatusRequestEntityTooLarge, "payload_too_large", "Request body too large")
 		return
 	}
+	_ = rc.SetReadDeadline(time.Time{})
 	respondJSON(w, http.StatusOK, map[string]any{"input_tokens": proxy.EstimateInputTokens(raw)})
 }
