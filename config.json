{
  "reverse_proxy": {
    "port": 8080,
    "target_host": "http://localhost:3000",
    "targets": ["http://localhost:3000"],
    "cache_ttl": 60,
    "cache_max_entries": 10000,
    "rate_limit": 10.0,
    "max_retries": 3,
    "protocol_escalation": ["http/1.1", "http/2", "ja3", "websocket", "browser", "stealth"],
    "circuit_breaker_threshold": 5,
    "health_check_interval": 30,
    "auto_load_proxies": true,
    "stealth": {
      "enabled": false,
      "browser": "chrome124",
      "user_agent_rotation": "sticky",
      "stealth_headers": true,
      "cookie_persistence": true,
      "timing_jitter_ms": [500, 2500]
    }
  },
  "governed_token_plane": {
    "enabled": true,
    "gateway": {
      "host": "127.0.0.1",
      "port": 20128,
      "token_env": "OWL_GATEWAY_TOKEN",
      "default_token_limit": 100000,
      "default_cost_limit_usd": 10.0,
      "window_seconds": 86400,
      "kill_switch": false,
      "cache_enabled": true,
      "cache_ttl": 3600
    },
    "routing": {
      "strategy": "local_first",
      "tiers": [
        {
          "tier": 1,
          "name": "local",
          "provider": "ollama",
          "model": "qwen2.5:14b",
          "api_base": "http://127.0.0.1:11434",
          "cost_per_1k_tokens": 0.0
        },
        {
          "tier": 2,
          "name": "free_cloud",
          "provider": "openai",
          "model": "gpt-4o-mini",
          "api_base": "https://api.openai.com/v1",
          "api_key_env": "OPENAI_API_KEY",
          "cost_per_1k_tokens": 0.15
        },
        {
          "tier": 3,
          "name": "paid_fallback",
          "provider": "anthropic",
          "model": "claude-3-5-haiku-20241022",
          "api_base": "https://api.anthropic.com",
          "api_key_env": "ANTHROPIC_API_KEY",
          "cost_per_1k_tokens": 0.80
        }
      ]
    },
    "free_catalog": {
      "enabled": true,
      "source": "marktantongco/awesome-free-llm-apis",
      "vendored_file": "gateway/free_catalog/providers.json",
      "default_cost_per_1k_tokens": 0.0,
      "providers": {
        "aion-labs": { "enabled": true, "api_key_env": "AION_API_KEY" },
        "cohere": { "enabled": true, "api_key_env": "COHERE_API_KEY" },
        "gemini": { "enabled": true, "api_key_env": "GEMINI_API_KEY" },
        "mistral": { "enabled": true, "api_key_env": "MISTRAL_API_KEY" },
        "z-ai": { "enabled": false, "api_key_env": "Z_AI_API_KEY" },
        "cloudflare-workers-ai": { "enabled": true, "api_key_env": "CLOUDFLARE_API_TOKEN" },
        "gonka-broker": { "enabled": false, "api_key_env": "GONKA_API_KEY" },
        "groq": { "enabled": true, "api_key_env": "GROQ_API_KEY" },
        "kilo-code": { "enabled": true, "api_key_env": null },
        "llm7": { "enabled": true, "api_key_env": "LLM7_API_KEY" },
        "modelscope": { "enabled": false, "api_key_env": "MODELSCOPE_API_KEY" },
        "nvidia-nim": { "enabled": true, "api_key_env": "NVIDIA_API_KEY" },
        "openrouter": { "enabled": true, "api_key_env": "OPENROUTER_API_KEY" },
        "ovhcloud": { "enabled": true, "api_key_env": null },
        "siliconflow": { "enabled": false, "api_key_env": "SILICONFLOW_API_KEY" }
      },
      "dead_routes_denylist": [],
      "is_paid_vendor_model_denylist": [
        "claude-", "gpt-5.", "gemini-", "grok-", "glm-5.", "minimax-"
      ]
    },
    "circuit_breaker": {
      "threshold": 5,
      "cooldown_seconds": 60
    },
    "edge": {
      "nginx": {
        "listen": 443,
        "rate_limit": "10r/s",
        "burst": 20
      },
      "caddy": {
        "admin_port": 20190
      }
    },
    "key_isolation": {
      "provider_keys_in_gateway_env_only": true,
      "clients_receive_gateway_tokens_only": true,
      "no_provider_keys_leaked_to_clients": true
    }
  }
}
